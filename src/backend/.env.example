# Copy this file to .env and fill in your values
# NEVER commit .env to git

# Server
PORT=5000
FRONTEND_URL=http://localhost:1234

# Auth — change this to a long random string in production
JWT_SECRET=change-me-to-a-long-random-secret-string

# MongoDB — persistent user storage (required for production on Render)
# Free cluster at https://mongodb.com/atlas → Create → M0 Free → Get connection string
# Format: mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority
# Leave blank to use local JSON files (fine for development only)
MONGODB_URI=

# Anthropic (Claude) — get your key at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# SerpAPI — for LIVE competitor rate data from Google Hotels (100 free searches/month)
# Get free key at https://serpapi.com/register
# Without this key the app uses realistic demo data instead
SERPAPI_KEY=
